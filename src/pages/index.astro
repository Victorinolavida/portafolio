---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import IntroductionMyself from '../components/Introduction.astro'
import AboutMe from '../components/AboutMe.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'
import WorkExperience from '../components/WorkExperience.astro'
import Projects from '../components/Projects.astro'
import Sponsors from '../components/Sponsors.astro'
import Analytics from '@vercel/analytics/astro'
---

<!doctype html>
<html lang="en">
  <head>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtm.js?id=GTM-NB6DBMSV"></script>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-YVNDW206KH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-YVNDW206KH')
    </script>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <Analytics />
  </head>
  <body>
    <Header />
    <main>
      <IntroductionMyself />
      <WorkExperience />
      <Projects />
      <AboutMe />
      <Sponsors />
    </main>
    <Footer />
  </body>
</html>
