---
import { WORK_EXPERIENCE } from '../content/data'
---

<section id="work-experience" class="content-section work-experience">
  <div class="section-heading">
    <p class="section-number">01</p><h2>Experience<span>.</span></h2>
  </div>
  <ul class="work-experience-list">
    {
      WORK_EXPERIENCE.map((job) => (
        <li>
          <p class="work-date">
            {job.startDate} — {job.endDate}
          </p>
          <div class="work-title">
            <>
              <h3>{job.company}</h3>
              <p>{job.position}</p>
            </>
          </div>
          <p class="work-description">{job.description}</p>
        </li>
      ))
    }
  </ul>
</section>
