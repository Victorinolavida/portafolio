---
import Icons from './IconContainer.astro'
const icons = [
  {
    href: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg',
    caption: 'Astro',
  },
  {
    href: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg',
    caption: 'CSS',
  },
  {
    href: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg',
    caption: 'JavaScript',
  },
  {
    href: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vercel/vercel-original.svg',
    caption: 'Vercel',
  },
]
---

<article class="project-card">
  <div class="project-content">
    <h3>Portfolio</h3>
    <p>
      A personal portfolio built with Astro to share my experience and projects.
    </p>
    <a
      class="project-link"
      data-analytics-event="project_link_click"
      data-analytics-value="Portfolio"
      href="https://github.com/Victorinolavida/portafolio"
      target="_blank"
      rel="noopener noreferrer"
      >View on GitHub <span aria-hidden="true">↗</span></a
    >
  </div>
  <Icons icons={icons} />
</article>
